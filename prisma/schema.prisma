// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String          @id @default(cuid())
  name      String
  email     String          @unique
  password  String
  createdAt DateTime        @default(now())

  saved     SavedCollege[]
}

model College {
  id          String          @id @default(cuid())
  name        String
  location    String
  fees        Int
  rating      Float
  description String
  placements  String
  image       String
  createdAt   DateTime        @default(now())

  courses     Course[]
  reviews     Review[]
  savedBy     SavedCollege[]
}

model Course {
  id          String   @id @default(cuid())
  name        String
  duration    String
  fees        Int

  collegeId   String
  college     College  @relation(fields: [collegeId], references: [id])
}

model Review {
  id          String   @id @default(cuid())
  userName    String
  comment     String
  rating      Float

  collegeId   String
  college     College  @relation(fields: [collegeId], references: [id])
}

model SavedCollege {
  id          String   @id @default(cuid())

  userId      String
  collegeId   String

  user         User     @relation(fields: [userId], references: [id])
  college      College  @relation(fields: [collegeId], references: [id])
}
